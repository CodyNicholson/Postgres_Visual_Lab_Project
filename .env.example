# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file
# when it is missing. Add the lab's own settings (API keys, tuning knobs) below.

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=

# Password of the `lab` superuser on the lab database. Leave empty to use the built-in
# local-only default (the database is never published outside the Docker network).
# Only takes effect when the pgdata volume is first created.
POSTGRES_PASSWORD=

# Password of the `replicator` role the streaming replica connects as (same rules).
REPLICATION_PASSWORD=
